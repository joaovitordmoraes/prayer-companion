{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@components/*": ["./app/components/*"],
      "@screens/*": ["./app/screens/*"],
      "@assets/*": ["./app/assets/*"],
      "@utils/*": ["./app/utils/*"],
      "@routes/*": ["./app/routes/*"]
    }
  }
}
